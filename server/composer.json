{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "xuey490/project",
    "description": "A lightweight Powerful Fast, Simple, Safety PHP framework",
    "type": "project",
    "keywords": [
        "Fssphp",
        "WorkerMan",
        "Symfony",
        "Thinkphp",
        "ThinkORM",
        "FPM",
        "flexible",
        "php framework"
    ],
    "homepage": "https://github.com/xuey490/FssAdmin_php",
    "license": "MIT",
    "authors": [
        {
            "name": "blue2004",
            "email": "xuey863toy@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/xuey490/FssAdmin_php/issues",
        "source": "https://github.com/xuey490/FssAdmin_php"
    },
    "require": {
        "php": "^8.3",
        "casbin/casbin": "^4.2",
        "ezyang/htmlpurifier": "^4.18",
        "guzzlehttp/guzzle": "^7.10",
        "illuminate/config": "13.30.*",
        "illuminate/database": "13.30.*",
        "illuminate/events": "13.30.*",
        "illuminate/pagination": "13.30.*",
        "intervention/image": "^4.0.4",
        "lcobucci/clock": "^3.5",
        "lcobucci/jwt": "^5.6",
        "league/commonmark": "^2.6",
        "monolog/monolog": "^3.9.0",
        "phpoption/phpoption": "^1.9",
        "phpseclib/phpseclib": "^3.0",
        "predis/predis": "^3.3",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "ramsey/uuid": "^4.9.2",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/translation": "^7.4",
        "topthink/think-cache": "^3.0.1",
        "topthink/think-orm": "^4.0.51",
        "topthink/think-template": "^3.0.2",
        "topthink/think-validate": "^3.0.7",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6",
        "workerman/workerman": "^5.2.0",
        "xuey490/config": "^1.0.4",
        "xuey490/database": "dev-main",
        "xuey490/log": "^1.0.2",
        "xuey490/storage": "^1.1.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "icanhazstring/composer-unused": "^0.9.5",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Framework\\": "framework/",
            "App\\": "app/",
            "App\\Admin\\": "app/admin/",
            "App\\System\\": "app/system/",
            "Plugins\\": "plugins/"
        },
        "files": [
            "framework/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --no-coverage",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite Unit --no-coverage",
        "analyse": "phpstan analyse -c phpstan.neon --memory-limit=1G",
        "cs-fix": "php-cs-fixer fix --diff"
    },
    "scripts-descriptions": {
        "test": "Run the default PHPUnit suite without coverage",
        "test:unit": "Run the Unit test suite without coverage",
        "analyse": "Run PHPStan static analysis",
        "cs-fix": "Apply PHP-CS-Fixer formatting"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
