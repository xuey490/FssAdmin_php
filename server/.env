APP_ENV=test

APP_DEBUG=true

APP_URL=http://localhost:8000

REFERER_CHECK_ENABLED=true

# CORS 跨域来源白名单（逗号分隔，禁止使用 *）。同源/代理开发可留空；
# 前后端分离时填写前端域名，例：CORS_ALLOWED_ORIGINS=https://admin.example.com
CORS_ALLOWED_ORIGINS=

# 数据库配置
# ORM选择'thinkORM' or 'laravelORM'
ORM_DRIVER=laravelORM
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fssoa
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8
DB_PREFIX=sa_

# Session 相关配置
SESSION_STORAGE=redis  #redis_grouped
SESSION_TTL=3600
SESSION_GROUP_PREFIX=session:myapp

# Redis 连接配置（缓存 / Session / JWT / 限流 / Casbin watcher 统一读这里）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=10
REDIS_PASSWORD=


# Cache设置
CACHE_DRIVER=redis

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# COOKIE设置
COOKIE_SECRET=your-actual-32-character-secret-here
COOKIE_DOMAIN=.yourdomain.com

##jwt设置
JWT_SINGLE_DEVICE_LOGIN=false   # 允许多设备
JWT_SECRET=base64:CYqbZODqtR7hAkY556K9POz9bZwplPLlrJBhKjVmo3UO5hq0MM0BA6LJeSvYO7NtRgM
# JWT_SINGLE_DEVICE_LOGIN=true  # 单点登录

# 【必填】JWT 签名密钥，必须是 >=32 字节的随机强密钥，且每个环境唯一、严禁入库。
# 不设置或使用弱/默认值时框架会拒绝启动。生成示例：php -r "echo 'base64:'.base64_encode(random_bytes(48));"
JWT_SECRET=

AI_HTTP_VERIFY=true

# Workerman 端口分流（Linux: php server.php start 同时听 8000+8001）
# Windows 另开：php server-ai.php start
# WORKERMAN_HTTP_PORT=8000
# WORKERMAN_HTTP_COUNT=4
# WORKERMAN_AI_PORT=8001
# WORKERMAN_AI_COUNT=4
# 生产 Nginx/Apache 分流后建议打开，避免 /api/ai/ 打到 8000
# WORKERMAN_HTTP_REJECT_AI=1