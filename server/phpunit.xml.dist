<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="default"
         failOnDeprecation="false"
         failOnWarning="false"
         beStrictAboutOutputDuringTests="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/BugConditionExplorationTest.php</exclude>
            <exclude>tests/Unit/MultiTenantDeptIsolationBugTest.php</exclude>
            <exclude>tests/Unit/MultiTenantDeptIsolationPreservationTest.php</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>integration</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory suffix=".php">framework</directory>
        </include>
    </source>
</phpunit>
